environment = "prd"
aws_region  = "us-west-2"

# Optional HA: set secondary_region to enable active/passive replication
# across two AWS regions. Leave commented (or set to "") for single-region.
# When set, every stateful resource (DDB, SQS, S3, S3 Vectors, AppConfig)
# is provisioned in both regions and EventBridge cross-region rules
# replicate writes between them. Failover is operator-driven via the
# AppConfig console (see docs/HA.md). The two regions must both support
# the Bedrock model selected by bedrock_model_id and S3 Vectors; verify
# in the AWS console before setting.
# secondary_region = "us-east-1"

# GitHub repos are now managed via workspace UI, not Terraform
# Add repos to workspaces using the GitHub App integration
# Repo types: "application" for full apps (code-maps), "standards" for ADR-only repos (file-ingestion)

# GitHub usernames to tag when tests fail
# Single user: "yourusername"
# Team: "user1,user2,user3"
github_usernames_to_tag = "yourusername"

# ============================================================================
# Initial Admin
# ============================================================================

# Email of the initial org admin (manages all workspaces, can add other org
# admins). Required when enable_workspaces is true. No default - must be set.
# initial_org_admin_email = "admin@example.com"

# ============================================================================
# Workspaces Feature
# ============================================================================

# Enable workspaces (team/project groupings with OAuth integrations:
# Confluence, Jira, Outlook, Teams, SharePoint). Default: TRUE.
# enable_workspaces = true    # set false for a minimal single-tenant deploy

# ============================================================================
# Integration Toggles
# ============================================================================

# Enable GitHub Issues integration - webhook triggers code generation from
# issue labels. Default: true.
# enable_github_issue_integration = true

# Enable Jira Automation integration via SSM Document. Default: false.
# enable_jira_integration = false

# Atlassian Automation AWS account ID for SSM document sharing.
# Required if enable_jira_integration is true. No default.
# atlassian_automation_account_id = "123456789012"

# Jira to GitHub Repo Mapping (via Jira Components)
# ------------------------------------------------
# No Terraform mapping needed! Instead, create a Jira component with the
# GitHub repo path as its name (e.g., "bcarpio/my-repo").
#
# In Jira Automation, use these Smart Values:
#   - issueKey         -> {{issue.key}}
#   - issueSummary     -> {{issue.summary}}
#   - issueDescription -> {{issue.description}}
#   - componentKey     -> {{issue.components.name}}

# ============================================================================
# GitHub App
# ============================================================================

# GitHub App credentials. Create the App in GitHub > Settings > Developer
# settings > GitHub Apps. Store the private key + webhook secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/github/app-private-key" \
#     --type SecureString --value "$(cat private-key.pem)"
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/github/webhook-secret" \
#     --type SecureString --value "your-webhook-secret"
# github_app_id     = "123456"
# github_app_slug   = "my-company-ai-assist"
# github_client_id  = "Iv1.xxxxxxxxxxxxxxxx"

# ============================================================================
# Atlassian OAuth (Confluence + Jira)
# ============================================================================

# Atlassian OAuth App Client ID for Confluence/Jira integration. No default.
# Store the client secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/oauth/atlassian/client-secret" \
#     --type SecureString --value "your-client-secret"
# atlassian_oauth_client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# External ID generated by Atlassian when configuring the AWS integration.
# Required if enable_jira_integration is true. No default.
# jira_external_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ============================================================================
# Bedrock Models
# ============================================================================

# Model IDs for the three Bedrock invocation paths. Defaults are the latest
# Claude Haiku/Sonnet + Titan v2 embeddings. Override only when AWS releases
# a newer model or when running in a region with limited model availability.
# bedrock_advanced_model_id  = "us.anthropic.claude-sonnet-5-5"
# bedrock_basic_model_id     = "us.anthropic.claude-haiku-5-5"
# bedrock_embedding_model_id = "amazon.titan-embed-text-v2:0"

# --- OpenAI GPT instead of Claude (model choice, NOT a separate environment) ---
# To run on OpenAI frontier models (GPT-5.6 on Amazon Bedrock) rather than
# Anthropic Claude, override the two model IDs below in THIS prd deploy -- there
# is no separate "openai" environment or workspace.
# Typical driver: compliance customers who must retire Anthropic Claude entirely
# from the inference path (embedding + rerank stay on Titan + Cohere, which are
# not Anthropic).
#
# MODEL FAMILY (GPT-5.6, prices per 1M tokens verified on the AWS Bedrock
# pricing page 2026-07-30 -- re-check before deploying):
#   - Sol   -- premium flagship. $5.50 in / $33.00 out. us-east-1 + us-east-2
#              ONLY (same price as the older GPT-5.5).
#   - Terra -- balanced: GPT-5.5-level quality at lower cost. $2.20 in /
#              $13.20 out. Available us-east-1, us-east-2, AND us-west-2.
#   - Luna  -- fast/cheap, high-volume. $0.22 in / $1.32 out. Same regions as
#              Terra (incl. us-west-2). This is the gpt-mini-equivalent basic tier.
# Older GPT-5.5 ($5.50/$33.00, us-east-2 only) and GPT-5.4 ($2.75/$16.50,
# us-east-2 + us-west-2) remain selectable.
#
# REGION: because Terra + Luna are now in us-west-2 (the default region), an
# all-GPT deploy can run advanced=Terra / basic=Luna in us-west-2 WITHOUT
# relocating to us-east-2 (which the us-east-2-only GPT-5.5 previously forced).
# Choose Sol only if you accept us-east-1/us-east-2. Under HA, the secondary
# region must also carry the chosen models.
#
# MODEL IDs: the frontier GPT-5.x models are served by Bedrock Mantle (Responses
# API) and are NOT returned by `aws bedrock list-foundation-models` (that lists
# only the openai.gpt-oss-* Converse models). Confirm the exact model-ID string
# in the Bedrock console model catalog or via the Mantle /v1/models endpoint --
# the strings below follow the 5.5 naming pattern but are UNVERIFIED.
# bedrock_advanced_model_id = "us.openai.gpt-5-6-terra:0"   # VERIFY exact ID
# bedrock_basic_model_id    = "us.openai.gpt-5-6-luna:0"    # VERIFY exact ID
# Pricing tfvars mirror the model choice (Terra advanced / Luna basic). NOTE:
# per docs/tech-debt.md, audit.py currently HARDCODES per-model pricing and
# ignores these tfvars, so cost_usd on audit rows will mis-attribute a GPT-5.6
# deploy until that tech-debt is reconciled.
# bedrock_advanced_input_price  = 2.20    # Terra
# bedrock_advanced_output_price = 13.20   # Terra
# bedrock_basic_input_price     = 0.22    # Luna
# bedrock_basic_output_price    = 1.32    # Luna

# Cooldown between Bedrock API calls to avoid throttling on small accounts.
# Default: true. Disable for enterprise accounts with high quotas.
# enable_bedrock_cooldown = true

# ADR-016 v1.2 cost-attribution tag for the within-app workflow
# dimension (chat / code-maps / code-gen / pr-analyzer). Value is
# always the workload slug; the tag NAME defers to your org's
# approved cost allocation tag vocabulary so this platform never
# forces you to activate a platform-specific tag.
#
# Default is "Purpose" (Application / Environment / Project / Purpose
# is the maintainer's convention). Common enterprise alternatives:
# "Component", "Function", "Workload", "Service".
#
# Whatever you pick MUST be activated in Billing > Cost Allocation
# Tags for Cost Explorer to split spend by workload.
# bedrock_workload_tag_name = "Purpose"

# ============================================================================
# Bedrock Reranking
# ============================================================================

# Toggle Cohere-Rerank-on-Bedrock entirely. Default: true. Set to false in
# regions without Cohere Rerank availability or to skip the marketplace
# billing relationship; chat / query fall back to raw vector-similarity
# ordering when disabled.
# bedrock_rerank_enabled       = true

# Reranker model + tuning knobs.
# bedrock_rerank_model_id      = "cohere.rerank-v3-5:0"
# bedrock_rerank_price_per_1k  = 2.00  # USD per 1,000 search queries
# rerank_max_fetch             = 90    # Max documents to over-fetch for reranking
# rerank_min_score             = 0.15  # Min relevance score (0-1) to include in results

# ============================================================================
# Bedrock Model Pricing (USD per million tokens)
# ============================================================================

# Update these when changing models to ensure accurate cost tracking.
# bedrock_advanced_input_price  = 3.0   # Sonnet input
# bedrock_advanced_output_price = 15.0  # Sonnet output
# bedrock_basic_input_price     = 0.80  # Haiku input
# bedrock_basic_output_price    = 4.0   # Haiku output

# Max characters per document in RAG context.
# Increase for larger code maps; decrease to reduce token costs.
# rag_max_doc_chars = 3000

# ============================================================================
# Audit & Compliance
# ============================================================================

# Email address for AI refusal alert notifications.
# When set, an SNS subscription is created and you'll receive an email to confirm.
# audit_alert_email = "your-team@example.com"

# ============================================================================
# Analytics Cost Alerts
# ============================================================================

# Enable the daily cost-alert Lambda. When enabled, an SNS topic is created
# and the Lambda publishes the first time monthly spend crosses a threshold.
# cost_alert_enabled               = false

# Email subscribed to the cost-alerts SNS topic. You'll receive a confirmation
# email the first time the stack is applied.
# cost_alert_email                 = "finops@example.com"

# Monthly thresholds in USD. Defaults to 0 = alert disabled. Set to a
# positive value to enable.
# cost_alert_org_monthly_usd       = 0
# cost_alert_workspace_monthly_usd = 0

# ============================================================================
# Database Integration (MSSQL / MySQL / Postgres schema introspection)
# ============================================================================

# Provision the workspace Database integration (introspect_database + schema
# drift). Default: false. Requires enable_workspaces = true. Turning this ON is
# also what builds + pushes the database-integration / database-sync container
# images -- with it off, `make pre-deploy` skips those two images entirely
# (they'd have no Lambda to run in). Turn it on only if you'll connect databases.
# enable_database_integration = true

# ============================================================================
# Database Drift Notifications
# ============================================================================

# Email addresses subscribed to the database-drift SNS topic. Notifications
# fire on schema-level drift only — i.e. a DBA created or dropped a schema
# since the prior sync, so the admin needs to revisit Configure Scope to
# decide whether to add it. Table-level changes inside already-selected
# schemas are auto-ingested on the next sync and are NOT emailed (the
# admin has no action to take on them). Empty list = no topic created,
# no notifications fire — the DATABASE_SYNCED audit row still carries
# schemas_added / schemas_removed / tables_added / tables_removed fields
# regardless, so audit-table polling and downstream consumers still work.
#
# Each email gets an AWS SNS SubscribeNow email on first apply; click-confirm
# to activate. The topic ARN is also exposed as a terraform output
# (database_drift_topic_arn) for orgs wanting to wire additional subscribers
# (Slack webhook via Lambda, PagerDuty integration, SQS routing, etc.).
# database_drift_notification_emails = ["dba@example.com", "alerts@example.com"]

# EventBridge cron expression controlling when the alert Lambda runs.
# Default: 13:00 UTC daily (~6am PT / 9am ET).
# cost_alert_schedule_expression   = "cron(0 13 * * ? *)"

# ============================================================================
# Chat UI + MCP server (Fargate) -- deployed by DEFAULT
# ============================================================================
# deploy_ui and mcp_server_enabled BOTH default to true -- the chat UI and the
# MCP server are the core product. Both run on Fargate inside the VPC below, so
# these two network vars are REQUIRED (terraform errors if they are unset):

ui_vpc_id             = "vpc-REPLACE_ME"                                 # REQUIRED
# ui_private_subnet_ids: >= 2 subnets in different AZs. They can be PUBLIC or
# PRIVATE despite the name -- pair with ui_fargate_assign_public_ip below
# (true = public/IGW subnets, no NAT; false = private + NAT/TGW/Direct Connect).
ui_private_subnet_ids = ["subnet-REPLACE_ME_A", "subnet-REPLACE_ME_B"]   # REQUIRED: >= 2 AZs

# deploy_ui          = true    # default; set false ONLY for a deliberate headless (CLI+GitHub) deploy
# ui_container_image: OPTIONAL. Leave unset -- the UI ECS task auto-uses the
#   image `make build-ui-image` pushes to ECR (:latest). Only set this to pin a
#   specific image/digest, e.g.:
# ui_container_image = "123456789012.dkr.ecr.us-west-2.amazonaws.com/prd-outcome-ops-ai-assist-chat-ui:sometag"
# ui_fargate_assign_public_ip = true    # set true when ui_private_subnet_ids are PUBLIC subnets (IGW, no NAT)

# ALB Access Mode (see docs/adr/ADR-042 for the design rationale):
#   true  = Internal ALB. RECOMMENDED for customer / enterprise deploys.
#          The ALB has no public IP; customers route traffic to it via
#          their existing enterprise ingress (Direct Connect, Transit
#          Gateway, VPN, on-VPC compute). This is the SOC 2 / HIPAA /
#          FedRAMP-friendly posture the product is designed around.
#   false = Public ALB, guarded solely by Azure AD OIDC at the Express
#          layer. Intended for the OutcomeOps maintainer's sandbox and
#          low-stakes PoCs. The variable default is `true`, so
#          customer deploys inherit the
#          safer posture automatically. Sandbox deploys must now
#          explicitly set `ui_alb_internal = false`.
# ui_alb_internal = true

# Assign public IP to Fargate tasks. Default: false.
# Set true for public subnets without NAT; false for private subnets with
# NAT, Transit Gateway, or Direct Connect outbound.
# ui_fargate_assign_public_ip = false

# ============================================================================
# Microsoft Outlook 365 Integration
# ============================================================================

# Microsoft Entra ID (Azure AD) App Registration for Outlook integration.
# Required permissions: Mail.Read, Mail.ReadBasic, offline_access, openid, profile, email
# microsoft_oauth_client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Before enabling Outlook, store the client secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/oauth/microsoft/client-secret" \
#     --type SecureString --value "your-client-secret"

# ============================================================================
# OIDC Authentication (Azure AD)
# ============================================================================

# Domain for HTTPS + OIDC (required when oidc_enabled = true).
# FQDN: {ui_subdomain}.{domain} when append_environment_to_fqdn=false
# (production-style, first-class subdomain), or
# {ui_subdomain}-{environment}.{domain} when true (dev/test style).
# Requires a Route53 hosted zone for this domain in your account.
# domain = "example.com"
# ui_subdomain = "outcomeops"  # default
# append_environment_to_fqdn = false  # prd: first-class subdomain

# ============================================================================
# DNS Sovereignty + TLS Certificate Sourcing
# ============================================================================
# By default, terraform manages Route53 for var.domain in THIS account
# and issues an ACM public DNS-validated cert. Override either or both
# of those when the customer manages DNS elsewhere (cross-account
# Route53, Infoblox, AD-DNS, etc.) or wants to use their own cert
# (org-wide ACM wildcard, internal-CA cert imported to ACM, etc.).
# See docs/byo-cert-and-dns.md.

# Set false when var.domain is NOT in Route53 in this AWS account.
# Terraform will skip all Route53 + ACM-validation resources and
# output alb_dns_name + fqdn_to_cname for you to wire up externally.
# manage_dns_in_route53 = true

# ARN of a pre-existing ACM cert covering local.fqdn. Set this to BYO
# a cert: org-wide ACM wildcard, public-CA cert imported to ACM, or
# private / internal-CA cert imported to ACM. Required when
# manage_dns_in_route53 = false.
# ui_acm_certificate_arn = "arn:aws:acm:us-west-2:111122223333:certificate/abc-..."

# SSM SecureString ARNs holding PEM-encoded CA roots to bake into the
# platform Lambda trust store. Required when ui_acm_certificate_arn
# points at a private / internal-CA cert - without these roots, chat
# -> MCP calls fail TLS verification. Same model as
# customer_ca_bundle_ssm_param_arns (database images).
# platform_ca_bundle_ssm_param_arns = [
#   "arn:aws:ssm:us-west-2:111122223333:parameter/prd/outcome-ops-ai-assist/ca/corp-root",
# ]

# Azure AD configuration.
# oidc_enabled   = true
# oidc_client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"  # Azure App (client) ID
# oidc_tenant_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"  # Azure Directory (tenant) ID
#
# UI SIGN-IN REDIRECT URI: on THIS OIDC app registration (oidc_client_id), add
# the redirect URI
#     https://<your-deploy-fqdn>/oauth2/idpresponse
# That path is the ALB's built-in OIDC callback -- see docs/azure-ad-setup.md
# Step 6. It is the *login* callback and is NOT the same as the
# /api/<integration>/callback URIs further down this file: those belong to the
# separate data-source integration apps (Azure DevOps, GitLab, ServiceNow,
# Salesforce), not to signing into the UI. Putting an /api/... callback on your
# sign-in app is a common mix-up -- the actual login redirect is
# /oauth2/idpresponse.

# Before enabling OIDC, store the client secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/oidc/client-secret" \
#     --type SecureString --value "your-client-secret"
# See docs/azure-ad-setup.md for full setup instructions.

# --- Azure AD group -> workspace provisioning (ADR-048) -------------------
# Bind Entra security groups to workspaces so membership follows the OIDC
# `groups` claim. Recommended app config: groupMembershipClaims=ApplicationGroup
# (emit only groups assigned to the app) so the claim is curated + bounded.
#
# azure_ad_group_patterns = ["outcomeops-*", "*-outcomeops-*"]  # eligibility scope
# azure_ad_group_sync_enabled = true
#
# If your enterprise app emits on-prem group NAMES (sAMAccountName) for synced
# groups, enable the credential-free name-matching + picker path:
# azure_ad_group_name_claim_enabled = true
#
# For cloud-only groups (or a complete "search all eligible groups" picker),
# enable the app-only Graph read (Group.Read.All, application, admin-consented).
# This is the customer's own tenant grant -- no vendor-held credential.
#
# DEFAULT: reuses the OIDC login app (oidc_client_id / oidc_tenant_id) and its
# secret at /<env>/<app>/oidc/client-secret. Just add the Group.Read.All
# Application permission + admin consent to that existing app, then set one flag:
# azure_ad_group_graph_fallback_enabled = true
#
# OPTIONAL: to use a DEDICATED read-only Graph app instead (separate from the
# login credential), also set these overrides (secret path is only ever put here
# for the dedicated case -- never for the default):
# azure_ad_graph_client_id       = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# azure_ad_graph_secret_ssm_path = "/prd/outcome-ops-ai-assist/azure/graph-secret"
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/azure/graph-secret" \
#     --type SecureString --value "your-graph-app-client-secret"

# ============================================================================
# MCP Server Catalog
# ============================================================================

# SonarQube MCP server (code quality + security analysis).
# Deploys as a Fargate Spot task in the same VPC as the UI.
# Before enabling, store your SonarQube token in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/mcp/sonarqube-token" \
#     --type SecureString --value "your-sonarqube-token"
# See docs/sonarqube-mcp.md for full setup instructions.
# mcp_sonarqube_enabled = false
# mcp_sonarqube_url     = ""
# mcp_sonarqube_org     = ""

# Snyk MCP server (vulnerability scanning of generated code).
# Before enabling, store your Snyk token in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/mcp/snyk-token" \
#     --type SecureString --value "your-snyk-token"
# mcp_snyk_enabled = false
# mcp_snyk_org     = ""

# OutcomeOps MCP server (knowledge base access for Claude Code, VS Code, Cursor).
# Default: TRUE. Runs on Fargate in ui_vpc_id/ui_private_subnet_ids (required
# above); needs Docker for the container image build.
# First-time deploy: ENVIRONMENT=prd make build-mcp-server-image
# See docs/mcp-server.md for full setup instructions.
# mcp_server_enabled = true    # set false to skip the MCP server

# ============================================================================
# Security Scanner
# ============================================================================

# AWS Security Agent integration: service-account session-cookie OIDC bypass
# for automated security tooling. Default: false.
# security_scanner_enabled = false
# security_scanner_email   = "security-scanner@outcomeops.local"

# ============================================================================
# Encryption (CMK)
# ============================================================================

# Use a Customer Managed KMS Key (CMK) for data-at-rest encryption on S3,
# DynamoDB, SQS, SNS, ECR, and Kinesis. When false, services use AWS-managed
# encryption (AES256 / SSE-SQS / aws/sns / aws/kinesis). Default: false.
# enable_cmk_encryption = false

# ============================================================================
# PII Redaction
# ============================================================================

# Org-level kill switch. true = redact PII on ingest in STRICT workspaces.
# false = no redaction anywhere, even in STRICT workspaces.
# Default: true. Only flip when redaction is moved out-of-band or when
# deploying to a region without Comprehend Detect-PII (terraform plan will
# fail loudly if you enable redaction in an unsupported region).
# pii_redaction_enabled = true

# USD per 1,000,000 characters scanned by Comprehend Detect-PII. Default
# matches the AWS public price ($1.00 / 1M chars). Override only if you
# have a negotiated rate.
# comprehend_pii_price_per_1m_chars = 1.00

# Comprehend entity types that pass through unredacted even in STRICT mode.
# The default tunes the platform for a developer / engineering knowledge
# base, where URL, IP_ADDRESS, MAC_ADDRESS, and DATE_TIME are load-bearing
# references in runbooks, infra docs, release notes, and cert-expiry
# trackers - not personally-identifying. Override with [] to redact
# everything Comprehend detects (right call for HR-content or customer-
# support workspaces).
# pii_redaction_skip_types = ["URL", "IP_ADDRESS", "MAC_ADDRESS", "DATE_TIME"]

# ============================================================================
# Audit Stream Export (SIEM hook)
# ============================================================================

# Provision a Kinesis Data Stream and a publisher Lambda that re-emits
# every audit-log INSERT as an OCSF v1.3.0 envelope. Customers' security
# teams attach their own consumer (Splunk, Datadog, Sumo, AWS Security
# Lake, or a Firehose to S3). On-demand Kinesis, 24h retention, CMK
# flows from enable_cmk_encryption automatically. See
# docs/audit-stream-export.md for OCSF schema + FilterCriteria patterns.
audit_stream_export_enabled = true

# ============================================================================
# Azure DevOps integration (off by default; see docs/runbooks/azure-devops-setup.md)
# ============================================================================

# Master switch. When false, the azure-devops Lambdas deploy but UI / OAuth
# endpoints return 404. Leave false until the four config values below are
# populated AND verified end-to-end against your Entra ID app registration.
# enable_azure_devops_integration = false

# Master switch for the Azure DevOps Boards (work items) integration.
# Reuses the same tenant / client-id / client-secret above; requires
# vso.work API permission granted on the app registration + the
# https://{fqdn}/api/azure-devops-boards/callback URI registered as a
# second redirect URI on the same app. The Lambda derives the callback
# from local.fqdn; you don't type it in tfvars.
# enable_azure_devops_boards_integration = false

# Entra ID tenant ID hosting your Azure DevOps OAuth app registration.
# azure_devops_tenant_id = ""

# Entra ID app registration client ID (NOT the same app as
# microsoft_oauth_client_id; ADO uses a dedicated app for cleaner
# consent-screen scopes).
# azure_devops_client_id = ""

# SSM SecureString parameter name holding the Entra ID app client secret.
# Terraform does NOT create or read this value; the operator puts it via
# `aws ssm put-parameter --type SecureString` per the customer runbook.
# azure_devops_client_secret_ssm_param = ""

# Azure DevOps *integration* OAuth callback -- for connecting ADO repos as a
# data source, NOT for UI sign-in. Registered on the Azure DevOps integration's
# Entra app (azure_devops_client_id), which is separate from the UI sign-in app
# (oidc_client_id). Must match
# https://<your-deploy-fqdn>/api/azure-devops/callback exactly (no trailing
# slash, no query string). Mismatch is the most common setup failure for this
# integration. (The UI login redirect is /oauth2/idpresponse -- see the oidc_*
# block above.)
# azure_devops_redirect_uri = ""

# ============================================================================
# GitLab integration (off by default; see docs.outcomeops.ai integrations/gitlab)
# ============================================================================

# Master switch. Provisions the gitlab-integration / gitlab-sync /
# gitlab-scheduler Lambdas + SQS + Function URL (and their secondary-region
# mirrors when secondary_region is set).
# enable_gitlab_integration = false

# Application ID of the group-owned GitLab OAuth application. Register it
# with the `api` scope (MR-note posting needs it; GitLab has no narrower
# write scope) and redirect URI https://<your-deploy-fqdn>/api/gitlab/callback.
# gitlab_client_id = ""

# Self-managed GitLab base URL. Leave default for gitlab.com.
# gitlab_base_url = "https://gitlab.com"

# OPTIONAL override: SSM SecureString path for the OAuth app secret. When
# empty, terraform creates a placeholder at
# /<env>/<app>/gitlab/client-secret (in both regions under HA) and you
# overwrite the value post-apply with `aws ssm put-parameter --overwrite`.
# gitlab_client_secret_ssm_param = ""

# OPTIONAL override: OAuth redirect URI. Derived from the deploy FQDN when
# empty; must match the OAuth application registration exactly.
# gitlab_redirect_uri = ""

# ---------------------------------------------------------------------------
# Multiple GitLab instances (ADR-050 v2.0)
# ---------------------------------------------------------------------------
# Connect gitlab.com AND self-managed instances at the same time -- an
# acquirer on SaaS absorbing a self-managed company, a migration where both
# are live, or a regulated split. Leave EMPTY to keep the single-instance
# behaviour above (gitlab_base_url / gitlab_client_id / secret param), which
# needs no migration and no reconnect.
#
# Each instance needs its OWN OAuth application registered on that instance
# and its OWN secret parameter -- never point two instances at one secret.
# gitlab_instances = [
#   {
#     id                      = "saas"
#     display_name            = "GitLab.com"
#     base_url                = "https://gitlab.com"
#     client_id               = "<gitlab.com app id>"
#     client_secret_ssm_param = "/prd/outcome-ops-ai-assist/gitlab/client-secret"
#   },
#   {
#     id                      = "internal"
#     display_name            = "GitLab (internal)"
#     base_url                = "https://gitlab.example.com"
#     client_id               = "<self-managed app id>"
#     client_secret_ssm_param = "/prd/outcome-ops-ai-assist/gitlab/client-secret-internal"
#   },
# ]

# ============================================================================
# ECS capacity: Fargate Spot master switch
# ============================================================================

# Allow FARGATE_SPOT for the ECS services (UI proxy + MCP servers, both
# regions). Spot cuts container cost ~70% but tasks can be reclaimed with a
# two-minute warning, interrupting in-flight chat streams / MCP sessions on
# the reclaimed task. Default FALSE = 100% on-demand (the enterprise
# posture; leave it unset). Sandbox/trial deploys opt in with true; the
# ui_fargate_* / mcp_server_* weight + base vars then tune the mix.
#
# LEAN / TESTING: set this true to run the UI + MCP on Spot for a cheap
# trial/PoC deploy -- the fastest way to keep container cost down while kicking
# the tires.
# fargate_enable_spot = true    # cheap testing; omit (false) for production

# ============================================================================
# GitHub Enterprise Server (GHES)
# ============================================================================

# GitHub instance base URL. Leave unset for github.com (SaaS). For GHES set
# e.g. "https://github.example.com" -- the REST API is derived as
# {base}/api/v3, raw content routes through the contents API, and clone URLs
# use the instance host. The GitHub App must be registered ON the GHES
# instance (App IDs / keys / webhook secrets are per-instance). Configurable
# but not yet certified against a live GHES.
# github_base_url = ""

# ============================================================================
# ServiceNow Knowledge Base integration
# ============================================================================
#
# One OAuth Application Registry entry per deploy. On your ServiceNow instance
# register an OAuth Authorization Code Grant app with Redirect URL
# https://<ui_fqdn>/api/servicenow/callback, then set the two tfvars below and
# populate the SecureString for the client secret:
#
#   aws ssm put-parameter \
#     --name /prd/outcome-ops-ai-assist/oauth/servicenow/client-secret \
#     --value "<from the Application Registry entry>" \
#     --type SecureString --overwrite
#
# enable_servicenow_integration = false
# servicenow_instance_url       = "https://acme.service-now.com"
# servicenow_oauth_client_id    = ""

# ============================================================================
# Salesforce CRM integration
# ============================================================================
#
# One shared Connected App per deploy (same shape as Confluence/Jira/M365).
# Register a Connected App on any Salesforce org, set OAuth policies to
# "Available for use by all users" and callback URL to
# https://<ui_fqdn>/api/salesforce/callback. Then set the two tfvars below
# and populate the SecureString for the consumer secret:
#
#   aws ssm put-parameter \
#     --name /prd/outcome-ops-ai-assist/oauth/salesforce/client-secret \
#     --value "<consumer secret from the Connected App>" \
#     --type SecureString --overwrite
#
# Instance URL is discovered per-workspace at OAuth time (customer's My
# Domain from the token response); NOT a deploy config. Sandbox vs prod
# is chosen by the workspace admin at connect time.
#
# enable_salesforce_integration = false
# salesforce_oauth_client_id    = ""

# ============================================================================
# Tags
# ============================================================================

# Custom tags merged with default tags (Environment, Application, ManagedBy).
# tags = {}

# ============================================================================
# Enterprise / F500 deployment profile
# ----------------------------------------------------------------------------
# Uncomment the block below for a 2000-engineer enterprise deploy behind a
# private VPC + Transit Gateway + Zscaler + Infoblox. Every knob has a
# sensible sandbox default; overriding here documents the enterprise
# intent explicitly rather than relying on defaults drifting.
#
# See docs/deployment-guide.md "Enterprise deployment profile" for the
# accompanying networking / KMS / Azure AD setup and the sharp edges
# (Function URL public DNS — see docs/adr/ADR-<TBD>-function-url-*.md).
# ============================================================================

# --- Network posture ---
# ui_alb_internal              = true    # Default; explicit here for clarity.
# ui_fargate_assign_public_ip  = false   # Private subnets with NAT / TGW egress.
# manage_dns_in_route53        = false   # Infoblox CNAME -> alb_dns_name.
# ui_acm_certificate_arn       = "arn:aws:acm:us-west-2:...:certificate/..."
# platform_ca_bundle_ssm_param_arns = [
#   "arn:aws:ssm:us-west-2:...:parameter/prd/outcome-ops-ai-assist/ca-bundle/enterprise-root",
# ]
# enable_github_issue_integration = false  # No public API Gateway ingress.

# --- Fargate autoscaling ---
# ui_fargate_min_count           = 4
# ui_fargate_max_count           = 40
# mcp_server_min_count           = 4
# mcp_server_max_count           = 40

# --- Fargate task sizing (per service; 256 = 0.25 vCPU) ---
# Every Fargate service is independently sizable. Defaults suit a light /
# sandbox deploy; raise for heavier enterprise load. cpu/memory must be a
# valid Fargate combo (e.g. 256 -> 512/1024/2048; 512 -> 1024..4096).
# ui_fargate_cpu       = 512    # UI proxy; default 512/1024
# ui_fargate_memory    = 1024
# mcp_server_cpu       = 1024   # OutcomeOps MCP (KB/code-map backend); memory-
# mcp_server_memory    = 2048   #   spiky under code-map load -- step down cautiously
# mcp_snyk_cpu         = 512    # Snyk MCP; low-traffic, halvable to 256/512
# mcp_snyk_memory      = 1024
# mcp_sonarqube_cpu    = 512    # SonarQube MCP; low-traffic, halvable to 256/512
# mcp_sonarqube_memory = 1024

# --- Bedrock fairness ---
# pr_check_max_concurrency  = 40
# chat_reserved_concurrency = 200

# --- Ingestion throughput ---
# github_sync_max_conc              = 50
# repo_summary_max_conc             = 100
# batch_summary_max_conc            = 100
# github_scheduler_parallel_workers = 64

# --- PR analysis CI trigger ---
# IAM role ARN(s) your CI assumes (e.g. a GitHub Actions OIDC role) that may
# invoke the analyze-pr and handle-command Lambdas directly. PR analysis uses
# CI direct-invoke, NOT a public webhook (see docs/getting-started.md "Trigger
# PR analysis"). The role is customer-managed (however you provision CI roles);
# this stack only adds it to the functions' resource policies. Empty = no CI
# trigger.
# ci_invoker_role_arns = ["arn:aws:iam::<ACCOUNT_ID>:role/github-actions-role"]

# Git author on commits the platform makes in your repos (code generation,
# test fixes). Defaults to "OutcomeOps Bot" <bot@outcomeops.ai>.
# codegen_git_author_name  = "OutcomeOps Bot"
# codegen_git_author_email = "outcomeops-bot@noreply.example.com"
