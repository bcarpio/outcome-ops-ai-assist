environment = "prd"
aws_region  = "us-west-2"

# GitHub repos are now managed via workspace UI, not Terraform
# Add repos to workspaces using the GitHub App integration
# Repo types: "application" for full apps (code-maps), "standards" for ADR-only repos (file-ingestion)

# GitHub usernames to tag when tests fail
# Single user: "yourusername"
# Team: "user1,user2,user3"
github_usernames_to_tag = "yourusername"

# ============================================================================
# Initial Admin
# ============================================================================

# Email of the initial org admin (manages all workspaces, can add other org
# admins). Required when enable_workspaces is true. No default - must be set.
# initial_org_admin_email = "admin@example.com"

# ============================================================================
# Workspaces Feature
# ============================================================================

# Enable workspaces (team/project groupings with OAuth integrations:
# Confluence, Jira, Outlook, Teams, SharePoint). Default: false.
# enable_workspaces = false

# ============================================================================
# Integration Toggles
# ============================================================================

# Enable GitHub Issues integration - webhook triggers code generation from
# issue labels. Default: true.
# enable_github_issue_integration = true

# Enable Jira Automation integration via SSM Document. Default: false.
# enable_jira_integration = false

# Atlassian Automation AWS account ID for SSM document sharing.
# Required if enable_jira_integration is true. No default.
# atlassian_automation_account_id = "123456789012"

# Jira to GitHub Repo Mapping (via Jira Components)
# ------------------------------------------------
# No Terraform mapping needed! Instead, create a Jira component with the
# GitHub repo path as its name (e.g., "bcarpio/my-repo").
#
# In Jira Automation, use these Smart Values:
#   - issueKey         -> {{issue.key}}
#   - issueSummary     -> {{issue.summary}}
#   - issueDescription -> {{issue.description}}
#   - componentKey     -> {{issue.components.name}}

# ============================================================================
# GitHub App
# ============================================================================

# GitHub App credentials. Create the App in GitHub > Settings > Developer
# settings > GitHub Apps. Store the private key + webhook secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/github/app-private-key" \
#     --type SecureString --value "$(cat private-key.pem)"
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/github/webhook-secret" \
#     --type SecureString --value "your-webhook-secret"
# github_app_id     = "123456"
# github_app_slug   = "my-company-ai-assist"
# github_client_id  = "Iv1.xxxxxxxxxxxxxxxx"

# ============================================================================
# Atlassian OAuth (Confluence + Jira)
# ============================================================================

# Atlassian OAuth App Client ID for Confluence/Jira integration. No default.
# Store the client secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/oauth/atlassian/client-secret" \
#     --type SecureString --value "your-client-secret"
# atlassian_oauth_client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# External ID generated by Atlassian when configuring the AWS integration.
# Required if enable_jira_integration is true. No default.
# jira_external_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ============================================================================
# Bedrock Models
# ============================================================================

# Model IDs for the three Bedrock invocation paths. Defaults are the latest
# Claude Haiku/Sonnet + Titan v2 embeddings. Override only when AWS releases
# a newer model or when running in a region with limited model availability.
# bedrock_advanced_model_id  = "us.anthropic.claude-sonnet-4-6"
# bedrock_basic_model_id     = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
# bedrock_embedding_model_id = "amazon.titan-embed-text-v2:0"

# Cooldown between Bedrock API calls to avoid throttling on small accounts.
# Default: true. Disable for enterprise accounts with high quotas.
# enable_bedrock_cooldown = true

# ============================================================================
# Bedrock Reranking
# ============================================================================

# Toggle Cohere-Rerank-on-Bedrock entirely. Default: true. Set to false in
# regions without Cohere Rerank availability or to skip the marketplace
# billing relationship; chat / query fall back to raw vector-similarity
# ordering when disabled.
# bedrock_rerank_enabled       = true

# Reranker model + tuning knobs.
# bedrock_rerank_model_id      = "cohere.rerank-v3-5:0"
# bedrock_rerank_price_per_1k  = 2.00  # USD per 1,000 search queries
# rerank_max_fetch             = 90    # Max documents to over-fetch for reranking
# rerank_min_score             = 0.15  # Min relevance score (0-1) to include in results

# ============================================================================
# Bedrock Model Pricing (USD per million tokens)
# ============================================================================

# Update these when changing models to ensure accurate cost tracking.
# bedrock_advanced_input_price  = 3.0   # Sonnet input
# bedrock_advanced_output_price = 15.0  # Sonnet output
# bedrock_basic_input_price     = 0.80  # Haiku input
# bedrock_basic_output_price    = 4.0   # Haiku output

# Max characters per document in RAG context.
# Increase for larger code maps; decrease to reduce token costs.
# rag_max_doc_chars = 3000

# ============================================================================
# Audit & Compliance
# ============================================================================

# Email address for AI refusal alert notifications.
# When set, an SNS subscription is created and you'll receive an email to confirm.
# audit_alert_email = "your-team@example.com"

# ============================================================================
# Analytics Cost Alerts
# ============================================================================

# Enable the daily cost-alert Lambda. When enabled, an SNS topic is created
# and the Lambda publishes the first time monthly spend crosses a threshold.
# cost_alert_enabled               = false

# Email subscribed to the cost-alerts SNS topic. You'll receive a confirmation
# email the first time the stack is applied.
# cost_alert_email                 = "finops@example.com"

# Monthly thresholds in USD. Defaults to 0 = alert disabled. Set to a
# positive value to enable.
# cost_alert_org_monthly_usd       = 0
# cost_alert_workspace_monthly_usd = 0

# ============================================================================
# Database Drift Notifications
# ============================================================================

# Email addresses subscribed to the database-drift SNS topic. Notifications
# fire on schema-level drift only — i.e. a DBA created or dropped a schema
# since the prior sync, so the admin needs to revisit Configure Scope to
# decide whether to add it. Table-level changes inside already-selected
# schemas are auto-ingested on the next sync and are NOT emailed (the
# admin has no action to take on them). Empty list = no topic created,
# no notifications fire — the DATABASE_SYNCED audit row still carries
# schemas_added / schemas_removed / tables_added / tables_removed fields
# regardless, so audit-table polling and downstream consumers still work.
#
# Each email gets an AWS SNS SubscribeNow email on first apply; click-confirm
# to activate. The topic ARN is also exposed as a terraform output
# (database_drift_topic_arn) for orgs wanting to wire additional subscribers
# (Slack webhook via Lambda, PagerDuty integration, SQS routing, etc.).
# database_drift_notification_emails = ["dba@example.com", "alerts@example.com"]

# EventBridge cron expression controlling when the alert Lambda runs.
# Default: 13:00 UTC daily (~6am PT / 9am ET).
# cost_alert_schedule_expression   = "cron(0 13 * * ? *)"

# ============================================================================
# Chat UI Deployment
# ============================================================================

# deploy_ui             = false
# ui_vpc_id             = "vpc-xxxxxxxx"
# ui_private_subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]
# ui_container_image    = "123456789012.dkr.ecr.us-west-2.amazonaws.com/outcome-ops-ai-assist-ui:latest"

# ALB Access Mode:
#   true  = Internal ALB (default) - customer provides VPC/TGW/DX/VPN access
#   false = Public ALB - secured by Azure AD OIDC
# ui_alb_internal = false

# Assign public IP to Fargate tasks. Default: false.
# Set true for public subnets without NAT; false for private subnets with
# NAT, Transit Gateway, or Direct Connect outbound.
# ui_fargate_assign_public_ip = false

# ============================================================================
# Microsoft Outlook 365 Integration
# ============================================================================

# Microsoft Entra ID (Azure AD) App Registration for Outlook integration.
# Required permissions: Mail.Read, Mail.ReadBasic, offline_access, openid, profile, email
# microsoft_oauth_client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Before enabling Outlook, store the client secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/oauth/microsoft/client-secret" \
#     --type SecureString --value "your-client-secret"

# ============================================================================
# OIDC Authentication (Azure AD)
# ============================================================================

# Domain for HTTPS + OIDC (required when oidc_enabled = true).
# FQDN: {ui_subdomain}.{domain} (prd) or {ui_subdomain}-dev.{domain} (dev).
# Requires a Route53 hosted zone for this domain in your account.
# domain = "example.com"
# ui_subdomain = "outcomeops"  # default

# Azure AD configuration.
# oidc_enabled   = true
# oidc_client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"  # Azure App (client) ID
# oidc_tenant_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"  # Azure Directory (tenant) ID

# Before enabling OIDC, store the client secret in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/oidc/client-secret" \
#     --type SecureString --value "your-client-secret"
# See docs/azure-ad-setup.md for full setup instructions.

# ============================================================================
# MCP Server Catalog
# ============================================================================

# SonarQube MCP server (code quality + security analysis).
# Deploys as a Fargate Spot task in the same VPC as the UI.
# Before enabling, store your SonarQube token in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/mcp/sonarqube-token" \
#     --type SecureString --value "your-sonarqube-token"
# See docs/sonarqube-mcp.md for full setup instructions.
# mcp_sonarqube_enabled = false
# mcp_sonarqube_url     = ""
# mcp_sonarqube_org     = ""

# Snyk MCP server (vulnerability scanning of generated code).
# Before enabling, store your Snyk token in SSM:
#   aws ssm put-parameter --name "/prd/outcome-ops-ai-assist/mcp/snyk-token" \
#     --type SecureString --value "your-snyk-token"
# mcp_snyk_enabled = false
# mcp_snyk_org     = ""

# OutcomeOps MCP server (knowledge base access for Claude Code, VS Code, Cursor).
# Requires deploy_ui = true and Docker for building the container image.
# First-time deploy: ENVIRONMENT=prd make build-mcp-server-image
# See docs/mcp-server.md for full setup instructions.
# mcp_server_enabled = false

# ============================================================================
# Security Scanner
# ============================================================================

# AWS Security Agent integration: service-account session-cookie OIDC bypass
# for automated security tooling. Default: false.
# security_scanner_enabled = false
# security_scanner_email   = "security-scanner@outcomeops.local"

# ============================================================================
# License Telemetry
# ============================================================================

# OutcomeOps license validator Lambda layer ARN. Empty = telemetry disabled.
# outcomeops_license_layer_arn = ""

# License server URL (defaulted; override only for testing against a
# non-production license server).
# outcomeops_license_server_url = "https://license.example.com"

# SSM parameter path for the license key.
# outcomeops_license_ssm_param = "/outcomeops/license/key"

# ============================================================================
# Encryption (CMK)
# ============================================================================

# Use a Customer Managed KMS Key (CMK) for data-at-rest encryption on S3,
# DynamoDB, SQS, SNS, ECR, and Kinesis. When false, services use AWS-managed
# encryption (AES256 / SSE-SQS / aws/sns / aws/kinesis). Default: false.
# enable_cmk_encryption = false

# ============================================================================
# PII Redaction
# ============================================================================

# Org-level kill switch. true = redact PII on ingest in STRICT workspaces.
# false = no redaction anywhere, even in STRICT workspaces.
# Default: true. Only flip when redaction is moved out-of-band or when
# deploying to a region without Comprehend Detect-PII (terraform plan will
# fail loudly if you enable redaction in an unsupported region).
# pii_redaction_enabled = true

# USD per 1,000,000 characters scanned by Comprehend Detect-PII. Default
# matches the AWS public price ($1.00 / 1M chars). Override only if you
# have a negotiated rate.
# comprehend_pii_price_per_1m_chars = 1.00

# Comprehend entity types that pass through unredacted even in STRICT mode.
# The default tunes the platform for a developer / engineering knowledge
# base, where URL, IP_ADDRESS, MAC_ADDRESS, and DATE_TIME are load-bearing
# references in runbooks, infra docs, release notes, and cert-expiry
# trackers - not personally-identifying. Override with [] to redact
# everything Comprehend detects (right call for HR-content or customer-
# support workspaces).
# pii_redaction_skip_types = ["URL", "IP_ADDRESS", "MAC_ADDRESS", "DATE_TIME"]

# ============================================================================
# Audit Stream Export (SIEM hook)
# ============================================================================

# Provision a Kinesis Data Stream and a publisher Lambda that re-emits
# every audit-log INSERT as an OCSF v1.3.0 envelope. Customers' security
# teams attach their own consumer (Splunk, Datadog, Sumo, AWS Security
# Lake, or a Firehose to S3). On-demand Kinesis, 24h retention, CMK
# flows from enable_cmk_encryption automatically. See
# docs/audit-stream-export.md for OCSF schema + FilterCriteria patterns.
audit_stream_export_enabled = true

# ============================================================================
# Tags
# ============================================================================

# Custom tags merged with default tags (Environment, Application, ManagedBy).
# tags = {}
