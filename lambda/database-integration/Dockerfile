# ============================================================================
# Database Integration Lambda Container Image
# ============================================================================
# UI-facing Lambda for the database integration. Handles:
#   - validate-connection (engine connection check)
#   - list-schemas (engine-driven metadata introspection for the schema picker)
#   - connection CRUD against DynamoDB
#
# Ships as a container image (not a Lambda layer + zip) because the
# schema introspection engine + Postgres/MySQL/MSSQL drivers total over 350 MB unzipped
# - well past Lambda's 250 MB unzipped layer cap. Container images allow
# up to 10 GB.
#
# Build:
#   ENVIRONMENT=dev make build-database-images
# ============================================================================

FROM public.ecr.aws/lambda/python:3.12

# Build context is repo root (`docker build -f lambda/database-integration/Dockerfile .`)
# so we can also COPY lambda/shared/ into the image.

# DATABAO-SPECIFIC: the upstream engine uses DuckDB internally for its
# migration / context-storage layer. DuckDB resolves $HOME for its
# extensions cache dir at connect time and raises IOException if HOME
# is unset or empty. AWS's lambda/python:3.12 image does NOT set HOME,
# so build_context fails before any datasource introspection happens
# ("Can't find the home directory at ''"). /tmp is the only writable
# path in Lambda; pointing HOME there satisfies DuckDB and is reset
# per cold start.
ENV HOME=/tmp

# DATABAO-SPECIFIC: mssql-python (Microsoft's new MSSQL driver, used by
# the upstream engine's MSSQL plugin) needs libtool-ltdl for dynamic
# driver loading and krb5-libs for its Kerberos client linkage (linked
# even when using SQL Auth). asyncpg/pymysql are pure-Python+C-ext and
# need nothing extra. AWS's lambda/python:3.12 base ships neither.
RUN dnf install -y libtool-ltdl krb5-libs ca-certificates && dnf clean all

# Bake the AWS RDS global CA bundle into the system trust store. The
# ODBC Driver 18 that mssql-python uses goes through OpenSSL, which
# reads from /etc/pki/ca-trust/extracted/openssl/ca-bundle.trust.crt
# (regenerated by update-ca-trust from the anchors dir below). Without
# this, RDS MSSQL connections fail with "unable to get local issuer
# certificate" because RDS uses its own CA chain rooted at Amazon's
# private RDS root. Same bundle covers all AWS regions.
ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
    /etc/pki/ca-trust/source/anchors/aws-rds-global-bundle.pem
RUN update-ca-trust

# Customer-provided CA bundles fetched from SSM by the build script
# and staged at lambda/.ca-bundles-staging/. If the dir contains only
# .gitkeep (no customer bundles configured), the COPY is a no-op and
# update-ca-trust regenerates the same bundle as before.
COPY lambda/.ca-bundles-staging/ /etc/pki/ca-trust/source/anchors/
RUN update-ca-trust

# Install the schema introspection engine plus the DB driver set the MVP
# supports. Drivers bring native components that the AWS-published
# Lambda Python image will compile against the runtime ABI.
COPY lambda/db-introspection-requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    find /var/lang/lib/python3.12/site-packages -name "tests" -type d -prune -exec rm -rf {} + 2>/dev/null || true && \
    find /var/lang/lib/python3.12/site-packages -name "__pycache__" -type d -prune -exec rm -rf {} + 2>/dev/null || true && \
    rm /tmp/requirements.txt

# Lambda handler + shared module live alongside under /var/task. The
# Python runtime adds /var/task to PYTHONPATH automatically.
COPY lambda/database-integration/ ${LAMBDA_TASK_ROOT}/
COPY lambda/shared/ ${LAMBDA_TASK_ROOT}/shared/

# Strip __pycache__ from the COPY'd code
RUN find ${LAMBDA_TASK_ROOT} -name "__pycache__" -type d -prune -exec rm -rf {} + 2>/dev/null || true && \
    find ${LAMBDA_TASK_ROOT} -name "Dockerfile" -delete 2>/dev/null || true

CMD [ "handler.lambda_handler" ]
