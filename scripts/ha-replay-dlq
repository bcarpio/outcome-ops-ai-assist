#!/usr/bin/env python3
# Copyright 2025-2026 OutcomeOps
# SPDX-License-Identifier: Apache-2.0
"""Drain a replication DLQ by re-PutEvents-ing the messages to the local
event bus (so the rule re-fires the applier).

Use case: primary region had an outage, secondary's primary->secondary
DLQ accumulated, primary recovered, operator drains the DLQ now that
secondary's applier is healthy.

Usage:
    AWS_PROFILE=customer-ops \\
        ENV=prd APP=outcome-ops-ai-assist \\
        REGION=us-east-1 \\
        QUEUE=prd-outcome-ops-ai-assist-replication-applier-dlq \\
        ./scripts/ha-replay-dlq [--max-messages N] [--dry-run]
"""

from __future__ import annotations

import argparse
import json
import os
import sys

import boto3
from botocore.exceptions import ClientError


def _env(name: str) -> str:
    val = os.environ.get(name, "").strip()
    if not val:
        print(f"ERROR: {name} env var is required", file=sys.stderr)
        sys.exit(2)
    return val


def main() -> int:
    parser = argparse.ArgumentParser(description="Replay messages from a replication DLQ")
    parser.add_argument("--max-messages", type=int, default=100)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    env_name = _env("ENV")
    app = _env("APP")
    region = _env("REGION")
    queue = _env("QUEUE")

    bus_name = f"{env_name}-{app}-replication"

    sqs = boto3.client("sqs", region_name=region)
    events = boto3.client("events", region_name=region)

    try:
        url = sqs.get_queue_url(QueueName=queue)["QueueUrl"]
    except ClientError as exc:
        print(f"ERROR: cannot resolve queue {queue} in {region}: {exc}", file=sys.stderr)
        return 2

    replayed = 0
    deleted = 0
    failed = 0
    while replayed < args.max_messages:
        resp = sqs.receive_message(
            QueueUrl=url,
            MaxNumberOfMessages=10,
            WaitTimeSeconds=2,
            VisibilityTimeout=30,
        )
        messages = resp.get("Messages", [])
        if not messages:
            break

        for msg in messages:
            replayed += 1
            try:
                body = json.loads(msg["Body"])
            except json.JSONDecodeError:
                print(f"  skip (non-JSON body) receipt={msg['ReceiptHandle'][:16]}")
                failed += 1
                continue

            detail = body.get("detail", body)
            detail_type = body.get("detail-type", detail.get("operation", "ddb_put_item"))
            source = body.get("source", f"{env_name}.{app}.ha-replication")

            entry = {
                "Source": source,
                "DetailType": detail_type,
                "EventBusName": bus_name,
                "Detail": json.dumps(detail),
            }

            if args.dry_run:
                print(f"  DRY-RUN would put: {detail_type} key={detail.get('key') or detail.get('bucket')}")
                continue

            try:
                events.put_events(Entries=[entry])
                sqs.delete_message(QueueUrl=url, ReceiptHandle=msg["ReceiptHandle"])
                deleted += 1
            except ClientError as exc:
                print(f"  put_events failed: {exc}", file=sys.stderr)
                failed += 1

    print(f"replayed={replayed} deleted={deleted} failed={failed}")
    return 0 if failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
