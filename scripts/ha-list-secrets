#!/usr/bin/env python3
"""List operator-populated SSM SecureStrings per region and report
which are still at the PLACEHOLDER_CONFIGURE_ME default.

Operators populate SecureString values manually after terraform apply
(terraform creates the resource with a placeholder, then
lifecycle.ignore_changes=[value] prevents subsequent applies from
clobbering an operator-set value). This script tells the operator
what's left to populate in each region.

Usage:
    AWS_PROFILE=customer-ops \\
        ENV=prd APP=outcome-ops-ai-assist \\
        PRIMARY=us-west-2 SECONDARY=us-east-1 \\
        ./scripts/ha-list-secrets
"""

from __future__ import annotations

import os
import sys
from typing import List

import boto3
from botocore.exceptions import ClientError


PLACEHOLDER = "PLACEHOLDER_CONFIGURE_ME"


SECRET_PARAMS: List[str] = [
    # GitHub App
    "/github/private-key",
    "/github/client-secret",
    "/github/webhook-secret",
    # Microsoft OAuth (shared across Outlook/OneDrive/OneNote/Teams/SharePoint)
    "/oauth/microsoft/client-secret",
    # Atlassian OAuth (shared across Confluence/Jira)
    "/oauth/atlassian/client-secret",
    # OIDC client secret (UI Azure AD authentication). Unlike the *-integration
    # OAuth client secrets above, this one is consumed at ECS task launch via
    # an environment data source — a missing or wrong value here breaks the
    # entire UI in that region, not just one integration.
    "/oidc/client-secret",
    # OutcomeOps license key. Read by every Lambda that calls the license
    # validator layer; the secondary region needs a local copy.
    "/license/key",
]


def _env(name: str) -> str:
    val = os.environ.get(name, "").strip()
    if not val:
        print(f"ERROR: {name} env var is required", file=sys.stderr)
        sys.exit(2)
    return val


def _check_region(region: str, env: str, app: str) -> int:
    ssm = boto3.client("ssm", region_name=region)
    populated = 0
    placeholder_count = 0
    missing = 0
    for path_suffix in SECRET_PARAMS:
        full_path = f"/{env}/{app}{path_suffix}"
        try:
            resp = ssm.get_parameter(Name=full_path, WithDecryption=True)
            value = resp["Parameter"]["Value"]
            if value == PLACEHOLDER:
                print(f"  [PLACEHOLDER] {full_path}")
                placeholder_count += 1
            else:
                print(f"  [populated]   {full_path}")
                populated += 1
        except ClientError as exc:
            code = exc.response.get("Error", {}).get("Code", "")
            if code == "ParameterNotFound":
                print(f"  [MISSING]     {full_path}")
                missing += 1
            else:
                print(f"  [ERROR]       {full_path}: {code}")
                missing += 1
    print(f"  -> populated={populated} placeholder={placeholder_count} missing={missing}")
    return placeholder_count + missing


def main() -> int:
    env = _env("ENV")
    app = _env("APP")
    primary = _env("PRIMARY")
    secondary = os.environ.get("SECONDARY", "").strip()

    print(f"=== Primary region: {primary} ===")
    primary_unset = _check_region(primary, env, app)
    print()

    if not secondary:
        print("Single-region deployment; no secondary to check.")
        return 0 if primary_unset == 0 else 1

    print(f"=== Secondary region: {secondary} ===")
    secondary_unset = _check_region(secondary, env, app)
    print()

    total_unset = primary_unset + secondary_unset
    if total_unset == 0:
        print(f"All {len(SECRET_PARAMS) * 2} SecureStrings populated across both regions.")
        return 0
    print(f"{total_unset} parameter(s) still need operator population.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
