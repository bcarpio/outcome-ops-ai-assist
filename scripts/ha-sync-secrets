#!/usr/bin/env python3
"""ha-sync-secrets — copy operator-populated SSM SecureStrings from the
primary region to the secondary region.

WHY THIS EXISTS
---------------
Terraform creates SecureString parameters with a PLACEHOLDER value and
``lifecycle.ignore_changes=[value]``. Operators populate the real
values manually (so the deploy role doesn't see plaintext). For an
HA-enabled deployment the SAME values need to exist in BOTH regions —
the secondary region's UI Fargate + integration Lambdas use the local
SSM endpoint, not the primary's.

This script reads each value from the primary region (with
decryption) and writes it to the secondary region. It is intentionally
narrow:

  - Only copies values that are POPULATED in primary (skips
    ``PLACEHOLDER_CONFIGURE_ME`` so a half-configured primary doesn't
    propagate placeholders to secondary).
  - Defaults to dry-run; ``--execute`` actually writes.
  - Idempotent: a populated secondary parameter is left untouched
    unless ``--overwrite`` is passed.

The list of synced parameters matches scripts/ha-list-secrets, so the
two scripts always agree on "what needs to exist in both regions."

USAGE
-----
    AWS_PROFILE=ops ENV=prd APP=outcome-ops-ai-assist \\
        PRIMARY=us-west-2 SECONDARY=us-east-2 \\
        ./scripts/ha-sync-secrets               # dry-run

    AWS_PROFILE=ops ENV=prd APP=outcome-ops-ai-assist \\
        PRIMARY=us-west-2 SECONDARY=us-east-2 \\
        ./scripts/ha-sync-secrets --execute     # actually copy

    ... --execute --overwrite                   # clobber populated secondary values

Or via the Makefile (auto-resolves PRIMARY/SECONDARY/APP from tfvars):

    AWS_PROFILE=ops ENV=prd make ha-sync-secrets                 # dry-run
    AWS_PROFILE=ops ENV=prd ARGS="--execute" make ha-sync-secrets

EXIT CODES
----------
0  Success (or dry-run completed)
1  Configuration / AWS error
2  Some parameters failed to sync (others may have succeeded)
"""

from __future__ import annotations

import argparse
import os
import sys
from typing import List, Tuple

import boto3
from botocore.exceptions import ClientError


PLACEHOLDER = "PLACEHOLDER_CONFIGURE_ME"

SECRET_PARAMS: List[str] = [
    "/github/private-key",
    "/github/client-secret",
    "/github/webhook-secret",
    # Legacy GitHub PAT (see ha-list-secrets for the discovery story).
    "/github/token",
    "/oauth/microsoft/client-secret",
    "/oauth/atlassian/client-secret",
    # ServiceNow OAuth Application Registry client secret. Consumed by the
    # servicenow-integration and servicenow-sync Lambdas via
    # SERVICENOW_CLIENT_SECRET_SSM_PARAM.
    "/oauth/servicenow/client-secret",
    # Salesforce Connected App consumer secret.
    "/oauth/salesforce/client-secret",
    # Azure DevOps Entra ID app client secret. Consumed by ADO
    # integration/sync/scheduler + Boards integration/sync/scheduler
    # in the secondary region. Path matches
    # var.azure_devops_client_secret_ssm_param.
    "/azure-devops/client-secret",
    # Bedrock/Mantle API key. Consumed by process-batch-summary,
    # process-repo-summary, and chat in the secondary region when a
    # Mantle/GPT backend is configured.
    "/bedrock/mantle-api-key",
    "/oidc/client-secret",
    # OutcomeOps license key. Read by every Lambda that calls the license
    # validator layer; the secondary region needs a local copy so license
    # validation does not require cross-region SSM reads.
    "/license/key",
]


def _env(name: str) -> str:
    val = os.environ.get(name, "").strip()
    if not val:
        print(f"ERROR: {name} env var is required", file=sys.stderr)
        sys.exit(1)
    return val


def _get(ssm, name: str) -> Tuple[str, str]:
    """Returns (status, value) where status is one of populated,
    placeholder, missing."""
    try:
        resp = ssm.get_parameter(Name=name, WithDecryption=True)
        value = resp["Parameter"]["Value"]
        if value == PLACEHOLDER:
            return "placeholder", value
        return "populated", value
    except ClientError as exc:
        if exc.response.get("Error", {}).get("Code") == "ParameterNotFound":
            return "missing", ""
        raise


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--execute",
        action="store_true",
        help="Actually write to secondary. Without this flag, runs in dry-run mode.",
    )
    parser.add_argument(
        "--overwrite",
        action="store_true",
        help="Replace already-populated secondary values too. By default the script only fills missing/placeholder entries.",
    )
    args = parser.parse_args()

    env = _env("ENV")
    app = _env("APP")
    primary = _env("PRIMARY")
    secondary = _env("SECONDARY")

    primary_ssm = boto3.client("ssm", region_name=primary)
    secondary_ssm = boto3.client("ssm", region_name=secondary)

    print(f"Primary:   {primary}")
    print(f"Secondary: {secondary}")
    print(f"Mode:      {'EXECUTE' if args.execute else 'DRY-RUN'}"
          f"{' (overwrite)' if args.overwrite else ''}")
    print()

    failed = 0
    copied = 0
    skipped = 0

    for suffix in SECRET_PARAMS:
        name = f"/{env}/{app}{suffix}"
        print(name)
        try:
            prim_status, prim_value = _get(primary_ssm, name)
        except ClientError as exc:
            print(f"  ERROR reading primary: {exc.response.get('Error', {}).get('Code')}")
            failed += 1
            continue

        if prim_status == "missing":
            print("  [skip] primary missing — populate primary first via aws ssm put-parameter")
            skipped += 1
            continue
        if prim_status == "placeholder":
            print("  [skip] primary still at PLACEHOLDER_CONFIGURE_ME — populate primary first")
            skipped += 1
            continue

        try:
            sec_status, _ = _get(secondary_ssm, name)
        except ClientError as exc:
            print(f"  ERROR reading secondary: {exc.response.get('Error', {}).get('Code')}")
            failed += 1
            continue

        if sec_status == "populated" and not args.overwrite:
            print("  [keep] secondary already populated — pass --overwrite to replace")
            skipped += 1
            continue

        action = "would overwrite" if sec_status == "populated" else (
            "would create" if sec_status == "missing" else "would replace placeholder"
        )

        if not args.execute:
            print(f"  [DRY-RUN] {action} in {secondary}")
            continue

        try:
            secondary_ssm.put_parameter(
                Name=name,
                Value=prim_value,
                Type="SecureString",
                Overwrite=True,
            )
            print(f"  [OK] {action.replace('would ', '')} in {secondary}")
            copied += 1
        except ClientError as exc:
            print(f"  ERROR writing secondary: "
                  f"{exc.response.get('Error', {}).get('Code')}")
            failed += 1

    print()
    print(f"Summary: copied={copied} skipped={skipped} failed={failed}")

    if args.execute:
        print()
        print("Next: re-run `make ha-list-secrets` to confirm the secondary")
        print("region is fully populated.")
    elif copied == 0 and failed == 0 and skipped == len(SECRET_PARAMS):
        print()
        print("Nothing to sync. Either everything is already in place, or")
        print("primary itself still has placeholders/missing entries (fix")
        print("primary first, then re-run).")
    else:
        print()
        print("Re-run with --execute to perform the sync.")

    if failed > 0:
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
