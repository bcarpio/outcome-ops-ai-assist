*.swo
*~
.DS_Store

# Environment
.env
.env.local
venv/
env/

# Logs
*.log

# Lambda layer binaries (built locally via scripts/build-*-layer.sh)
# Runtime layer
lambda/runtime-layer/bin/
lambda/runtime-layer/lib/
lambda/runtime-layer/libexec/

# Java layer
lambda/java-layer/java/

# Terraform layer (binaries only - keep README)
lambda/terraform-layer/bin/


# Scratch/working directory
.scratch/

# Local-only planning notes (chunked design specs handed to autonomous
# agents; per the EXECUTE.md convention they stay out of git so the
# repo doesn't accumulate stale plans next to shipped code). `plan/`
# is the default working dir; `plan-<name>/` is used only when a
# second plan needs to run alongside one already in `plan/`.
plan/
plan-*/
lambda/.license-layer-staging/

# Customer CA bundles fetched from SSM SecureString at image-build time
# by scripts/build-database-images.sh. The directory itself stays in the
# repo (via lambda/.ca-bundles-staging/.gitkeep) so the database
# Dockerfile COPY always has a source path even when no customer
# bundles are configured.
lambda/.ca-bundles-staging/*.pem

# Claude Code working directory - agent worktrees + tooling state.
# Should never end up in the repo (was added by an over-broad `git add -A`).
.claude/

# Ad-hoc experiment outputs (Haiku vs Sonnet code-map comparison etc.)
# Contents are throwaway — regenerate from scripts/*.
experiment/
